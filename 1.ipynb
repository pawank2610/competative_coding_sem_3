    "n=int(input(\"Enter number of elements: \"))\n",
    "arr=[]\n",
    "sum=0\n",
    "\n",
    "for i in range(n):\n",
    "    x=int(input(\"Enter element: \"))\n",
    "    arr.append(x)\n",
    "    sum=sum+x\n",
    "\n",
    "print(\"Elements:\",arr)\n",
    "print(\"Sum =\",sum)"
